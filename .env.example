# ============================================================
# .env.example — Environment Variables Template
# ============================================================
# 🔐 3-Layer Secret Architecture
#
# This file is COMMITTED to git as a reference template.
# Your actual secrets live in ~/.env (gitignored, chmod 600).
#
# Quick Start (new machine):
#   vault unlock    — decrypt secrets from bootstrap/vault/.env.enc
#   vault status    — check all secrets are set
#   vault init      — interactive wizard to fill in secrets
#
# Adding New Secrets (flexible — no script changes needed):
#   vault set-var MY_NEW_KEY        # add empty entry to this template
#   vault set MY_NEW_KEY "value"    # save value to ~/.env.secret
#   vault get MY_NEW_KEY            # print value (for scripts)
#   vault list                      # show all keys (masked)
#   vault del OLD_KEY               # remove a key
#   1. (optional) Add key here so 'vault status' tracks it
#   2. vault lock → git commit → git push
#
# Machine-local vars (JOE_ENV, *_PATH, NODE_*_HOST, …) are auto-excluded
# from the vault — see _is_machine_var() in bootstrap/vault/ssot-vault.sh.
#
# Non-interactive (CI/scripts):
#   export SSOT_VAULT_PASS='<pass>'
#   vault unlock
# ============================================================

# ── 1. Search APIs ──
export BRAVE_SEARCH_API_KEY=""
export BRAVE_API_KEY=""

# ── 2. Syncthing API Keys (Per-device cluster) ──
export NODE_OPPO_ST_KEY=""
export NODE_REDMI_ST_KEY=""
export NODE_TERMUX_ST_KEY=""
export NODE_WSL_ST_KEY=""
export NODE_WIN_ST_KEY=""
export NODE_MUMU_ST_KEY=""
export NODE_WSL2_ST_KEY=""

# ── 3. Wallets / Personal Information ──
export USDT_BEP20_BITKUB=""
export BEP20_BK=""
export SOL_BITKUB=""
export SOL_METAMAS=""
export BTC_BITKUB=""
export HOME_ADDRESS=""
export ais_fiber=""
export ais_phone=""

# ── 4. Social / Pages ──
export FACEBOOK_PAGE_TOKEN=""
export FACEBOOK_PAGE_ID=""
export SHOPEE_PAGE_TOKEN=""
export SHOPEE_PAGE_ID=""

# ── 5. OpenCode / AI Provider Keys ──
export OC_KEY_MOM=""
export OC_KEY_JOE=""
export OC_KEY_ZEN=""
export OC_KEY_ZEN_MOM=""
export OC_ZEN_MOM=""
export GH_TOKEN=""
export GH_TOKEN2=""
export usd_addres=""
export OPENCODE_API_KEY=""
export GEMINI_API_KEY=""
export AWS_BEARER_TOKEN_BEDROCK=""

# ── 6. AWS Bedrock Mantle (SigV4 Proxy) ──
# Used by: modules/opencode/bedrock_mantle_proxy.py
# Setup: oc install && oc start
# Models: deepseek.v3.1, qwen.qwen3-coder-480b, kimi-k2.5, etc. (18 total)
#
# AWS Credentials (required for SigV4 signing):
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
#
# Proxy Configuration (defaults usually work):
export BEDROCK_MANTLE_REGION="ap-southeast-2"
export BEDROCK_PROXY_HOST="127.0.0.1"
export BEDROCK_PROXY_PORT="4098"
export BEDROCK_MANTLE_MODEL="deepseek.v3.1"
