#!/bin/bash
# ============================================================
# ~/.local/bin/env — Global Environment & Profile Manager
# ============================================================
# Generated from bootstrap/templates/env by install.sh.
# Provides:
#   - PATH setup (~/.local/bin)
#   - Load ~/.env and ~/.env.secret
#   - shell_setup() — symlink shell profiles from $SSOT/profiles/
#   - repo()        — SSOT health dashboard & symlink repair
# ============================================================

# ── 1. PATH: Add ~/.local/bin if not already present ──
case ":${PATH}:" in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# ── 2. Load machine-local env vars (JOE_ENV, MY_DEVICE, SSOT) ──
[ -f "$HOME/.env" ] && . "$HOME/.env"

# Git Bash Guard: Force JOE_ENV on MSYS/MINGW
case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*)
        export JOE_ENV="GIT-BASH"
        ;;
esac

# ── 3. SSOT auto-detection ──
if [[ -z "${SSOT:-}" && -d "$HOME/ssot" ]]; then
    export SSOT="$HOME/ssot"
fi

# ── 4. Load decrypted shared secrets ──
[ -f "$HOME/.env.secret" ] && . "$HOME/.env.secret"

# ============================================================
# shell_setup() — Symlink shell profiles from $SSOT/profiles/
# ============================================================
shell_setup() {
    local env_="$(echo "${1:-${JOE_ENV:-$MY_DEVICE}}" | tr '[:lower:]' '[:upper:]')"
    local prof_name=""
    case "$env_" in
        TERMUX|PI)  prof_name="termux" ;;
        MUMU|KALI)  prof_name="mumu" ;;
        OPPO)       prof_name="oppo" ;;
        WSL)        prof_name="wsl" ;;
        WSL2)       prof_name="wsl2" ;;
        GIT-BASH)   prof_name="git-bash" ;;
        ACODEX)     prof_name="acodex" ;;
        USERLAND)   prof_name="userland" ;;
        *)
            echo "unknown environment '$env_': check \$JOE_ENV then run shell_setup again" >&2
            return 1
            ;;
    esac

    local prof_dir="${SSOT:-$HOME/ssot}/profiles/$prof_name"
    local rc="" src=""
    for rc in .bashrc .zshrc; do
        [[ "$prof_name" == "git-bash" && "$rc" == ".zshrc" ]] && continue
        src="$prof_dir/$rc"
        if [[ -f "$src" ]]; then
            rm -rf "$HOME/$rc"
            ln -sf "$src" "$HOME/$rc" \
                && echo "🔗 $HOME/$rc → $src" \
                || echo "❌ Failed to link $HOME/$rc" >&2
        fi
    done
}

# ============================================================
# repo() — Single-repo SSOT status & repair (~/ssot)
# ============================================================
repo() {
    local rp2="${HOME}/ssot"
    local rp="${1:-}"
    local repository=""

    if [[ -z "$rp" ]]; then
        repo_status
        return $?
    fi

    case "$rp" in
        b|ssot|fix|repair) repository="$rp2" ;;
        a|bashscripts|bsc)
            echo "⚠️  repo a (~/bashscripts) is retired — using ~/ssot." >&2
            repository="$rp2"
            ;;
        list)   repo_list; return 0 ;;
        status) repo_status; return 0 ;;
        *)
            if [[ -d "$rp" ]]; then
                repository="$rp"
            else
                echo "Usage: repo [status|fix|list|/path/to/repo]"
                return 1
            fi
            ;;
    esac

    if [[ ! -d "$repository" ]]; then
        echo "❌ Repository not found: $repository" >&2
        return 1
    fi

    echo "🔄 Re-wiring SSOT symlinks for: $repository"
    local _bin="$HOME/.local/bin"
    mkdir -p "$_bin"

    _safe_link() {
        rm -f "$2"
        ln -sf "$1" "$2"
    }

    # Clean broken symlinks in ~/.local/bin and $HOME
    local _dir="" _link_file=""
    for _dir in "$_bin" "$HOME"; do
        while IFS= read -r -d '' _link_file; do
            [[ ! -e "$_link_file" ]] && rm -f "$_link_file"
        done < <(find "$_dir" -maxdepth 1 -type l -print0 2>/dev/null)
    done

    # Persist SSOT in ~/.env
    if grep -q "^export SSOT=" "$HOME/.env" 2>/dev/null; then
        sed -i "s|^export SSOT=.*|export SSOT=\"$repository\"|" "$HOME/.env"
    else
        printf '\nexport SSOT="%s"\n' "$repository" >> "$HOME/.env"
    fi
    export SSOT="$repository"

    [[ -f "$HOME/.env" ]]        && _safe_link "$HOME/.env" "$repository/.env"
    [[ -f "$HOME/.env.secret" ]] && _safe_link "$HOME/.env.secret" "$repository/.env.secret"

    shell_setup "${2:-${JOE_ENV:-$MY_DEVICE}}"

    # Wire CLI tools
    local -A _tool_map=(
        [joe]="$repository/joe.sh"
        [node-status]="$repository/bootstrap/nodes/node-status.sh"
        [node-register]="$repository/bootstrap/nodes/node-register.sh"
        [vault]="$repository/bootstrap/vault/ssot-vault.sh"
        [dashboard]="$repository/bin/dashboard.sh"
        [env-manager]="$repository/bin/env-manager.sh"
        [mesh-sync]="$repository/bin/mesh-sync.sh"
        [cltui]="$repository/bin/dist-tui.sh"
    )
    local _t="" _src=""
    for _t in "${!_tool_map[@]}"; do
        _src="${_tool_map[$_t]}"
        if [[ -f "$_src" ]]; then
            chmod +x "$_src" 2>/dev/null || true
            _safe_link "$_src" "$_bin/$_t"
            echo "🔗 $_bin/$_t → $_src"
        fi
    done

    if [[ -f "$repository/bootstrap/templates/env" ]]; then
        cp "$repository/bootstrap/templates/env" "$_bin/env"
        chmod +x "$_bin/env"
        echo "✅ Updated $_bin/env"
    fi

    echo "🚀 Reloading shell (${SHELL:-bash})..."
    exec "${SHELL:-bash}"
}

repo_status() {
    local bold="" reset="" green="" yellow="" red="" cyan=""
    if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
        bold="$(tput bold 2>/dev/null || true)"
        reset="$(tput sgr0 2>/dev/null || true)"
        green="$(tput setaf 2 2>/dev/null || true)"
        yellow="$(tput setaf 3 2>/dev/null || true)"
        red="$(tput setaf 1 2>/dev/null || true)"
        cyan="$(tput setaf 6 2>/dev/null || true)"
    fi

    echo ""
    echo "${bold}${cyan}╔══════════════════════════════════════════════════════════════════╗${reset}"
    echo "${bold}${cyan}║              🔍 SSOT ECOSYSTEM & REPO DASHBOARD                  ║${reset}"
    echo "${bold}${cyan}╚══════════════════════════════════════════════════════════════════╝${reset}"
    echo ""
    echo "${bold}📌 Core Environment:${reset}"
    echo "   📁 Active SSOT   : ${green}${SSOT:-<not set>}${reset}"
    echo "   🌍 JOE_ENV       : ${green}${JOE_ENV:-<not set>}${reset}"
    echo "   📱 MY_DEVICE     : ${green}${MY_DEVICE:-<not set>}${reset}"
    echo "   🐚 Current Shell : ${SHELL:-$0}"
    echo ""
    echo "${bold}🔗 Symlink Integrity & Health Check:${reset}"

    _check_link() {
        local name="$1" path="$2" expected_prefix="${3:-}"
        if [[ -L "$path" ]]; then
            local tgt
            tgt="$(readlink "$path" 2>/dev/null)"
            if [[ ! -e "$path" ]]; then
                printf "   ❌ %-18s : ${red}BROKEN LINK${reset} → %s\n" "$name" "$tgt"
            elif [[ -n "$expected_prefix" && "$tgt" != "$expected_prefix"* ]]; then
                printf "   ⚠️  %-18s : ${yellow}MISMATCH LINK${reset} → %s\n" "$name" "$tgt"
            else
                printf "   ✅ %-18s : ${green}OK${reset} → %s\n" "$name" "$tgt"
            fi
        elif [[ -e "$path" ]]; then
            printf "   ⚠️  %-18s : ${yellow}REGULAR FILE (not symlinked)${reset}\n" "$name"
        else
            printf "   ❌ %-18s : ${red}MISSING${reset}\n" "$name"
        fi
    }

    local _root="${SSOT:-$HOME/ssot}"
    _check_link ".bashrc"         "$HOME/.bashrc"                   "$_root/profiles"
    [[ "${JOE_ENV:-}" != "GIT-BASH" ]] && _check_link ".zshrc" "$HOME/.zshrc" "$_root/profiles"
    _check_link "bin/joe"         "$HOME/.local/bin/joe"            "$_root"
    _check_link "bin/dashboard"   "$HOME/.local/bin/dashboard"      "$_root"
    _check_link "bin/env-manager" "$HOME/.local/bin/env-manager"    "$_root"
    _check_link "bin/mesh-sync"   "$HOME/.local/bin/mesh-sync"      "$_root"
    _check_link "bin/cltui"       "$HOME/.local/bin/cltui"          "$_root"
    _check_link "bin/vault"       "$HOME/.local/bin/vault"          "$_root"
    _check_link "bin/node-status" "$HOME/.local/bin/node-status"    "$_root"

    local node_script="$_root/bootstrap/nodes/node-status.sh"
    if [[ -f "$node_script" ]]; then
        echo ""
        echo "${bold}🌐 SSOT Mesh & Node Status:${reset}"
        bash "$node_script"
    fi
}

repo_list() {
    echo "Available repository:"
    echo "  ~/ssot — SSOT (Single Source of Truth)"
    [[ -d "$HOME/ssot" ]] && echo "  Status: ✅ exists" || echo "  Status: ❌ not found"
}

# ── Auto-source joe.sh ONLY when not already driven by .bashrc/.zshrc ──
if [[ "${_SSOT_RC_LOADING:-0}" != "1" && -n "${SSOT:-}" && -f "${SSOT}/joe.sh" ]]; then
    source "${SSOT}/joe.sh" 2>/dev/null
fi
