{
  "_comment": "MCP Servers for OpenCode v2 - SSOT Managed",
  "version": "1.0",
  "mcpServers": {
    "bedrock-mantle": {
      "name": "AWS Bedrock Mantle",
      "description": "AWS Bedrock Mantle Proxy for Claude models via SigV4",
      "transport": "stdio",
      "command": "python3",
      "args": [
        "${HOME}/.aws/opencode_bedrock_proxy.py",
        "mcp"
      ],
      "env": {
        "BEDROCK_MANTLE_REGION": "ap-southeast-2",
        "AWS_PROFILE": "default"
      },
      "autoStart": false,
      "profiles": ["default", "bedrock"]
    },
    "bedrock-proxy-http": {
      "name": "Bedrock Proxy HTTP",
      "description": "OpenAI-compatible endpoint for Bedrock via local proxy",
      "transport": "sse",
      "url": "http://127.0.0.1:4098/sse",
      "autoStart": true,
      "profiles": ["default", "bedrock"]
    }
  },
  "defaultProfile": "bedrock",
  "profiles": {
    "bedrock": {
      "name": "AWS Bedrock",
      "defaultProvider": "bedrock-mantle",
      "providers": ["bedrock-mantle", "bedrock-proxy-http"]
    }
  }
}
